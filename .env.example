# Copy to .env and fill in. Never commit .env.

# --- Claude (the brain) ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-4-8 (default, most capable) | claude-haiku-4-5 (fastest, best for low-latency voice)
CLAUDE_MODEL=claude-opus-4-8

# --- ElevenLabs (the voice) ---
ELEVENLABS_API_KEY=...
# Default "Rachel" voice (exists on every account). Pick any voice ID from your ElevenLabs library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_flash_v2_5 (lowest latency) | eleven_turbo_v2_5 | eleven_multilingual_v2 (highest quality)
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Deepgram (the ear / STT) — OPTIONAL ---
# If set, the browser streams mic audio to the server, which proxies it to Deepgram
# (the key never reaches the browser). If unset, the ear falls back to the browser's
# built-in speech recognition (Chrome/Edge only, less accurate). A normal transcription
# key is enough — it does NOT need token-grant permission.
DEEPGRAM_KEY=...
# nova-3 (default, most accurate) | nova-2 | enhanced | base
DEEPGRAM_MODEL=nova-3

# --- Server ---
PORT=3000
